{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "pnpm --filter @workspace/zfusionai run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply zfusionai --local",
    "db:migrate:remote": "wrangler d1 migrations apply zfusionai --remote",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@workspace/db": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "^4.13.13",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "wrangler": "^4.151.0"
  }
}
