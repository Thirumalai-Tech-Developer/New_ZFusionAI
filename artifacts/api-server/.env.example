# Local development secrets for `wrangler dev` (copy to .env).
# Production: set each with `pnpm exec wrangler secret put <NAME>`.

# ─── AI Gateway (OpenAI-compatible) ──────────────────────────────────────────
# Any OpenAI-compatible endpoint (your own gateway, Cloudflare AI Gateway,
# OpenRouter, LiteLLM, ...). The worker calls ${AI_GATEWAY_URL}/chat/completions
AI_GATEWAY_URL=https://your-ai-gateway.example.com/v1
AI_GATEWAY_API_KEY=your-gateway-api-token

# ─── Local overrides ─────────────────────────────────────────────────────────
ENVIRONMENT=development
APP_URL=http://localhost:5173
SESSION_SECRET=dev-only-change-me-to-32-plus-random-characters

# ─── OAuth (optional for local dev) ──────────────────────────────────────────
# Google redirect URI: ${APP_URL}/api/auth/google/callback
# GitHub callback URL: ${APP_URL}/api/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
